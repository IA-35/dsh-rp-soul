{
  "name": "dsh-rp-soul",
  "version": "0.6.2",
  "description": "Compose the DSH system-prompt persona from a preset file under $DSH_HOME, with a settings-page editor and an in-process roleplay engine (mood / relationships / autonomous action).",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "persona",
    "soul",
    "roleplay",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "author": "IA-35",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IA-35/dsh-rp-soul.git"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.5-rc.1",
    "react": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
