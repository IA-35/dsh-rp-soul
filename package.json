{
  "name": "dsh-rp-soul",
  "version": "0.6.0",
  "description": "Compose the DSH system-prompt persona from multiple files under $DSH_HOME, with a settings-page editor, a Python roleplay engine (mood / relationships / autonomous action), cross-session memory and tool-free compaction.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "engine",
    "!engine/tests",
    "!engine/**/__pycache__",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./compaction": {
      "default": "./lib/compaction.js"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "persona",
    "soul",
    "roleplay",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "author": "IA-35",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IA-35/dsh-rp-soul.git"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.5-rc.1",
    "react": ">=18.0.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
